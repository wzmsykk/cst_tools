{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline",
    "domains",
    "features",
    "documents",
    "tools",
    "relations",
    "source_fingerprints"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "baseline": {
      "type": "object",
      "required": [
        "commit",
        "tracked_files",
        "evidence_scope"
      ],
      "properties": {
        "commit": {
          "type": "string"
        },
        "tracked_files": {
          "type": "integer"
        },
        "evidence_scope": {
          "type": "string"
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "patterns",
          "lifecycle_owner"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lifecycle_owner": {
            "type": "string"
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "sources",
          "tests",
          "docs",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/link"
            }
          },
          "docs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/link"
            }
          },
          "verification_note": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "authority",
          "provenance"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          },
          "availability": {
            "type": "string",
            "enum": [
              "repository-and-package",
              "package-only"
            ]
          },
          "review": {
            "$ref": "#/$defs/document_review"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "effect",
          "authorization",
          "arguments",
          "review_status",
          "entry_kind",
          "main_guard",
          "observed_arguments",
          "argument_discovery",
          "purpose",
          "unknown",
          "evidence"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "effect": {
            "type": "string"
          },
          "authorization": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_status": {
            "type": "string"
          },
          "entry_kind": {
            "type": "string",
            "enum": [
              "python-main",
              "support-module",
              "unparsed-support",
              "shell-script"
            ]
          },
          "main_guard": {
            "type": "boolean"
          },
          "observed_arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "argument_discovery": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "unknown": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "targets",
          "type",
          "trigger",
          "lifecycle",
          "cleanup",
          "evidence",
          "unknown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "#/$defs/locator"
          },
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/locator"
            }
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "type": "string",
            "minLength": 1
          },
          "cleanup": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "unknown": {
            "type": [
              "string",
              "null"
            ]
          },
          "consumers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/locator"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "source_fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "registry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enforce_tool_scope",
        "scope_note"
      ],
      "properties": {
        "enforce_tool_scope": {
          "type": "boolean"
        },
        "scope_note": {
          "type": "string"
        },
        "enforce_markdown_scope": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "label"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "anchor": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "label",
        "symbols"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anchor": {
          "type": "string"
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        }
      }
    },
    "document_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "baseline",
        "status",
        "scope",
        "checked_sources",
        "finding_ids",
        "limitations"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "baseline": {
          "type": "string"
        },
        "status": {
          "enum": [
            "operational-and-applicability-reviewed",
            "historical-scope-reviewed",
            "design-scope-reviewed",
            "external-source-scope-reviewed",
            "generated-template-reviewed",
            "applicability-only-reviewed"
          ]
        },
        "scope": {
          "type": "string"
        },
        "checked_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          }
        },
        "limitations": {
          "type": "string"
        },
        "content_sha256_at_review": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
